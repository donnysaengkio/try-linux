{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Try Linux",
        "width": 980,
        "height": 830,
        "minWidth": 700,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["appimage"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/donnysaengkio/try-linux/releases/download/tauri-updates/latest-linux.json"]
    }
  }
}
