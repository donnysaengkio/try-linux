{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Try Linux Prototype",
  "version": "0.1.0",
  "identifier": "io.github.donnysaengkio.trylinux.prototype",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Try Linux",
        "width": 980,
        "height": 830,
        "minWidth": 700,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
