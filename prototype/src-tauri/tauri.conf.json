{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Try Linux Preview",
  "version": "0.2.0",
  "identifier": "io.github.donnysaengkio.trylinux.prototype",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Try Linux",
        "width": 980,
        "height": 830,
        "minWidth": 700,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Try Linux",
    "shortDescription": "Try a Linux desktop in a virtual machine",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Try Linux Preview"
      }
    },
    "macOS": { "entitlements": "macos/entitlements.plist" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3N0FCNjVEQTE3MEYwMTkKUldRWjhIQ2hYYlo2VjZyUktmcDZWejFuNEpFejRUM2ExUThCaEFqRlhRU1JDQzB2N241K1l1VmQK",
      "endpoints": ["https://github.com/donnysaengkio/try-linux/releases/download/tauri-updates/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
