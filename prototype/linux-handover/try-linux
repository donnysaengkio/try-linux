#!/usr/bin/env python3
# Starts Try Linux from wherever this folder is (as Try Linux 1.0.x's launcher did): here, the stand-in that
# moves 1.0.x to Try Linux 2 (see trylinux/__main__.py).
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, here)
from trylinux.__main__ import main  # noqa: E402

sys.exit(main())
